# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Public site settings
NEXT_PUBLIC_SITE_URL=https://thelpgco.pk
NEXT_PUBLIC_SITE_NAME=THE LPG CO. PAKISTAN
# demo = management inspection (sample catalogues/projects labelled DEMO). production = public claims only.
NEXT_PUBLIC_SITE_MODE=production
# Optional: base URL used on /management-review/ localhost links
NEXT_PUBLIC_LOCAL_ORIGIN=http://localhost:3000
# Digits only with country code. Defaults in lib/site.ts are the company numbers.
NEXT_PUBLIC_PHONE=923069701659
NEXT_PUBLIC_WHATSAPP=923069701659
NEXT_PUBLIC_EMAIL=

# Lead storage (Supabase REST). Run supabase/leads.sql first.
# Without these, leads are written to .data/leads.jsonl in development only;
# in production the API returns 503 so leads are never silently lost.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional email notification for each new lead (Resend)
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
LEADS_FROM_EMAIL=

# SEO tooling only (Python scripts in docs/seo-plan/scripts/intel). NOT used by the website at runtime.
SERPER_API_KEY=

# Analytics (optional). GA4 measurement id, e.g. G-XXXXXXXXXX. Nothing is sent when empty.
NEXT_PUBLIC_GA_ID=
